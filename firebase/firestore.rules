rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(uid()));
    }

    function role() {
      return isSignedIn() ? userDoc().data.role : null;
    }

    function isAdmin() {
      return isSignedIn() && role() == 'admin';
    }

    function isTeacher() {
      return isSignedIn() && role() == 'teacher';
    }

    function isStudent() {
      return isSignedIn() && role() == 'student';
    }

    function isApprovedTeacher() {
      return isTeacher() &&
        get(/databases/$(database)/documents/teachers/$(uid())).data.status == 'approved';
    }

    function isOwner(userId) {
      return isSignedIn() && uid() == userId;
    }

    // ---------- users ----------
    // Profiles, role, payment status, daily AI query counter, Telegram User ID.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // A user may create their own profile document on signup, but cannot
      // grant themselves elevated roles or payment status.
      allow create: if isOwner(userId)
        && request.resource.data.role in ['student', 'teacher']
        && request.resource.data.paymentStatus == 'unpaid';
      // Users may update non-sensitive fields on their own doc; role and
      // paymentStatus are server-managed (webhooks / admin only).
      allow update: if isAdmin()
        || (isOwner(userId)
            && request.resource.data.role == resource.data.role
            && request.resource.data.paymentStatus == resource.data.paymentStatus);
      allow delete: if isAdmin();
    }

    // ---------- teachers ----------
    // Vetting records, verification document URLs, status, subject specializations.
    match /teachers/{teacherId} {
      allow read: if isOwner(teacherId) || isAdmin();
      allow create: if isOwner(teacherId)
        && request.resource.data.status == 'pending_vetting';
      // Only admins can flip status to approved/rejected.
      allow update: if isAdmin()
        || (isOwner(teacherId)
            && request.resource.data.status == resource.data.status);
      allow delete: if isAdmin();
    }

    // ---------- schedules ----------
    // Subject names, assigned teacher, start/end timestamps, recording URLs.
    match /schedules/{scheduleId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin()
        || (isApprovedTeacher()
            && request.resource.data.teacherId == uid());
      allow delete: if isAdmin();
    }

    // ---------- transactions ----------
    // Paystack reference IDs, student IDs, payment status, retry/fallback flags, amounts.
    match /transactions/{transactionId} {
      allow read: if isAdmin()
        || (isStudent() && resource.data.studentId == uid());
      // Transactions are only ever written by trusted server contexts
      // (Paystack webhook using the Admin SDK, which bypasses these rules).
      allow write: if false;
    }

    // ---------- ai_usage ----------
    // Per-student daily query counters for the Groq AI Library rate limit.
    match /ai_usage/{docId} {
      allow read: if isAdmin() || (isStudent() && docId.matches(uid() + '_.*'));
      allow write: if false; // written by server-side rate-limit transaction only
    }

    // ---------- webhook_events ----------
    // Retry/fallback logger for Paystack webhook events.
    match /webhook_events/{eventId} {
      allow read: if isAdmin();
      allow write: if false; // server-only via Admin SDK
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
