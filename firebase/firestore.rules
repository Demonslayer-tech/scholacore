rules_version = '2';

// ScholaCore — Firestore Security Rules
// Role model: student | teacher | admin. This is the ONLY rules file in
// the repo — do not create a second copy elsewhere; that caused real
// confusion in the previous rebuild attempt.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(uid()));
    }

    function role() {
      return isSignedIn() ? userDoc().data.role : null;
    }

    function isAdmin() {
      return isSignedIn() && role() == 'admin';
    }

    function isTeacher() {
      return isSignedIn() && role() == 'teacher';
    }

    function isStudent() {
      return isSignedIn() && role() == 'student';
    }

    function isApprovedTeacher() {
      return isTeacher() &&
        get(/databases/$(database)/documents/teachers/$(uid())).data.status == 'approved';
    }

    function isOwner(userId) {
      return isSignedIn() && uid() == userId;
    }

    // users/{uid}
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.role in ['student', 'teacher']
        && request.resource.data.paymentStatus == 'unpaid';
      allow update: if isAdmin()
        || (isOwner(userId)
            && request.resource.data.role == resource.data.role
            && request.resource.data.paymentStatus == resource.data.paymentStatus);
      allow delete: if isAdmin();
    }

    // teachers/{uid}
    match /teachers/{teacherId} {
      allow read: if isOwner(teacherId) || isAdmin();
      allow create: if isOwner(teacherId)
        && request.resource.data.status == 'pending_vetting';
      allow update: if isAdmin()
        || (isOwner(teacherId)
            && request.resource.data.status == resource.data.status);
      allow delete: if isAdmin();
    }

    // schedules/{scheduleId}
    match /schedules/{scheduleId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin()
        || (isApprovedTeacher() && request.resource.data.teacherId == uid());
      allow delete: if isAdmin();
    }

    // transactions/{transactionId} — server (Admin SDK) writes only
    match /transactions/{transactionId} {
      allow read: if isAdmin() || (isStudent() && resource.data.studentId == uid());
      allow write: if false;
    }

    // ai_usage/{uid}_{yyyy-mm-dd} — server writes only
    match /ai_usage/{docId} {
      allow read: if isAdmin() || (isStudent() && docId.matches(uid() + '_.*'));
      allow write: if false;
    }

    // webhook_events/{eventId} — server writes only
    match /webhook_events/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
