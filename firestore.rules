rules_version = '2';

// ScholaCore — Firestore RBAC
//
// Roles: developer, teacher, student, parent, bursary
// Interim states (not "real" roles, granted almost no access):
//   unregistered   — signed in (Telegram or web), no /users/{uid} record yet
//   pending_teacher — applied to teach, awaiting a developer's review
//
// Identity: Firebase Auth uid is either a Telegram numeric ID (Telegram
// launch path, see api/auth-telegram.ts) or Firebase's own generated uid
// (web email/password path, see api/auth-web.ts) — rules don't care which,
// they just compare request.auth.uid against document IDs/fields.
// request.auth.token.role is a custom claim set at token-mint time; role
// changes require re-minting, which every auth/signup endpoint does
// whenever a /users/{uid} role changes.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function role() {
      return request.auth.token.role;
    }

    function hasRole(r) {
      return isSignedIn() && role() == r;
    }

    function hasAnyRole(roles) {
      return isSignedIn() && role() in roles;
    }

    function isStaff() {
      return hasAnyRole(['teacher', 'bursary', 'developer']);
    }

    function isSelf(id) {
      return isSignedIn() && uid() == id;
    }

    function isGuardianOf(userDoc) {
      return isSignedIn() &&
        role() == 'parent' &&
        userDoc.data.guardianUid == uid();
    }

    // ---------------------------------------------------------------------
    // /users/{uid}
    // ---------------------------------------------------------------------
    match /users/{id} {
      allow read: if isSelf(id) || isGuardianOf(resource) || isStaff();

      allow create: if isSelf(id) &&
        request.resource.data.role in ['student', 'parent'];

      // Self can only touch their own non-sensitive profile fields; role,
      // subscription status, and unlockedLessons are staff/webhook-only.
      allow update: if (isSelf(id) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name'])) ||
        hasAnyRole(['bursary', 'developer']);

      allow delete: if hasRole('developer');
    }

    // ---------------------------------------------------------------------
    // /feeSchedules/{classId}
    // Includes paystackPlanCode + billingInterval for the subscription
    // model. Any signed-in user can read (needed to render pricing);
    // only bursary/developer can define or change it.
    // ---------------------------------------------------------------------
    match /feeSchedules/{classId} {
      allow read: if isSignedIn();
      allow write: if hasAnyRole(['bursary', 'developer']);
    }

    // ---------------------------------------------------------------------
    // /subscriptions/{subscriptionCode}
    // Maps a Paystack subscription back to a student — written exclusively
    // by the webhook (Admin SDK, bypasses rules). Read access mirrors
    // /transactions.
    // ---------------------------------------------------------------------
    match /subscriptions/{subscriptionCode} {
      allow read: if isSignedIn() && (
        resource.data.studentId == uid() ||
        hasAnyRole(['bursary', 'developer']) ||
        (role() == 'parent' &&
          exists(/databases/$(database)/documents/users/$(resource.data.studentId)) &&
          get(/databases/$(database)/documents/users/$(resource.data.studentId)).data.guardianUid == uid())
      );
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // /transactions/{reference}
    // Payment ledger. Written exclusively by the Paystack webhook (Admin
    // SDK). No client-side create/update/delete — must always be
    // server-attested.
    // ---------------------------------------------------------------------
    match /transactions/{reference} {
      allow read: if isSignedIn() && (
        resource.data.studentId == uid() ||
        hasAnyRole(['bursary', 'developer']) ||
        (role() == 'parent' &&
          exists(/databases/$(database)/documents/users/$(resource.data.studentId)) &&
          get(/databases/$(database)/documents/users/$(resource.data.studentId)).data.guardianUid == uid())
      );
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // /teacherApplications/{applicantId}
    // Signing up as a teacher IS submitting this application (see
    // src/components/SignUp.tsx) — gated on AI screening via
    // /api/vet-teacher rather than granting access immediately.
    // ---------------------------------------------------------------------
    match /teacherApplications/{applicantId} {
      allow read: if isSelf(applicantId) || hasAnyRole(['teacher', 'developer']);

      allow create: if isSelf(applicantId) &&
        !('aiScore' in request.resource.data) &&
        !('aiSummary' in request.resource.data) &&
        request.resource.data.status == 'SUBMITTED';

      // An applicant can re-save their own application (e.g. a retry after
      // a dropped request) only while still SUBMITTED — before AI scoring
      // or a developer's decision has landed. Once status moves to
      // HIRE/INTERVIEW/REJECT, only a developer can touch the record.
      allow update: if (
          isSelf(applicantId) &&
          resource.data.status == 'SUBMITTED' &&
          request.resource.data.status == 'SUBMITTED' &&
          !('aiScore' in request.resource.data) &&
          !('aiSummary' in request.resource.data)
        ) ||
        (hasRole('developer') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));

      allow delete: if hasRole('developer');
    }

    // ---------------------------------------------------------------------
    // /applications/{applicationId}
    // Student admissions pipeline (placement test -> PENDING_FEE -> ENROLLED).
    // ---------------------------------------------------------------------
    match /applications/{applicationId} {
      allow read: if isSignedIn() && (
        resource.data.parentContact.uid == uid() ||
        hasAnyRole(['bursary', 'developer'])
      );

      allow create: if isSignedIn() &&
        request.resource.data.status == 'PENDING_FEE' &&
        request.resource.data.parentContact.uid == uid();

      allow update: if hasAnyRole(['bursary', 'developer']);
      allow delete: if hasRole('developer');
    }

    // ---------------------------------------------------------------------
    // /classes/{classId}/lessons/{lessonId}
    // ---------------------------------------------------------------------
    match /classes/{classId}/lessons/{lessonId} {
      allow read: if isSignedIn() && (
        resource.data.isPremium == false ||
        isStaff() ||
        get(/databases/$(database)/documents/users/$(uid())).data.unlockedLessons[lessonId] == true
      );
      allow write: if hasAnyRole(['teacher', 'developer']);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
