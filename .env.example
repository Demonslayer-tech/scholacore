# Copy to .env.local for local dev. In Vercel, set these under
# Project Settings -> Environment Variables instead.

# ---- Firebase (client — public identifiers, not secrets) ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---- Firebase (server — secret) ----
# Full service-account JSON as a single-line string.
FIREBASE_SERVICE_ACCOUNT_KEY=

# ---- Paystack ----
PAYSTACK_SECRET_KEY=
# Where Paystack redirects after checkout (not the webhook URL)
PAYSTACK_CALLBACK_URL=

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=

# ---- LiveKit ----
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
VITE_LIVEKIT_URL=

# ---- Groq ----
GROQ_API_KEY=
