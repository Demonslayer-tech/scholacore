# --- Telegram (server-side, read via getenv() in PHP) ---
TELEGRAM_BOT_TOKEN=
# Chat ID of the Telegram group students get invited to after payment.
TELEGRAM_CLASS_GROUP_CHAT_ID=

# --- Paystack ---
PAYSTACK_SECRET_KEY=
# Not secret, but still served through api/paystack-config.php rather
# than hardcoded in a static JS file.
PAYSTACK_PUBLIC_KEY=

# --- Groq (AI Library + teacher vetting), server-side only ---
GROQ_API_KEY=

# --- LiveKit ---
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Unclear what this was meant for -- LiveKit's own APIs (token auth,
# Egress) don't take an "egress ID" as config, it's an ID returned per
# recording. Not read by any code as of the live-classroom build; ask
# before removing in case it was meant for something specific.
LIVEKIT_EGRESS_ID=
# WebSocket URL from the LiveKit Cloud project dashboard, e.g.
# wss://your-project.livekit.cloud -- required for both joining rooms
# (api/livekit-token.php) and starting recordings (api/livekit-egress.php
# derives the HTTPS Egress API host from this).
LIVEKIT_WS_URL=
# Recording (api/livekit-egress.php) calls StartRoomCompositeEgress with
# no explicit storage output, which only works if a default egress
# output (S3/GCS/Azure) is configured on the LiveKit Cloud project
# dashboard under Settings > Egress. If that's not set up yet, "Start
# Recording" in the classroom will fail with a LiveKit error saying so.
# Also configure a webhook in that same dashboard pointing at
# https://<your-domain>/api/livekit-webhook.php with the "egress_ended"
# event enabled, so finished recordings get their URL written back.

# --- Firebase Admin SDK (server-side, PHP via kreait/firebase-php) ---
# Paste the full service-account JSON as a single-line string.
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- Firebase Web (client SDK) ---
# Not secret. Served through api/firebase-config.php rather than
# hardcoded, since there's no build-time env substitution without a
# bundler.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
