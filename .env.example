# --- Telegram (server-side only) ---
TELEGRAM_BOT_TOKEN=

# --- Paystack ---
PAYSTACK_SECRET_KEY=
# Public key is used client-side — must be VITE_-prefixed or Vite won't
# bundle it into the browser build.
VITE_PAYSTACK_PUBLIC_KEY=

# --- Groq (AI Library + teacher vetting), server-side only ---
GROQ_API_KEY=

# --- LiveKit ---
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_EGRESS_ID=
# Client connects to this URL directly — must be VITE_-prefixed.
VITE_LIVEKIT_WS_URL=

# --- Firebase Admin SDK (server-side only) ---
# Paste the full service-account JSON as a single-line string.
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- Firebase Web (client SDK) ---
# Not secret, but still needs the VITE_ prefix to reach the browser bundle.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
