# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- Paystack ---
PAYSTACK_SECRET_KEY=
# Public key must be prefixed VITE_ to be readable by the client bundle.
VITE_PAYSTACK_PUBLIC_KEY=

# --- Groq (AI Study Library + teacher vetting) ---
# api/ai-tutor.ts and api/vet-teacher.ts both read GROQ_API_KEY.
# (Note: README currently references Gemini — that's stale; the code uses Groq.)
GROQ_API_KEY=

# --- LiveKit (live classrooms) ---
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Client needs the ws:// url to connect — must be VITE_-prefixed.
VITE_LIVEKIT_WS_URL=

# --- Firebase Admin SDK (server-only, api/_lib/firebaseAdmin.ts) ---
# Paste the full service-account JSON as a single-line string.
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- Firebase Web (client SDK) ---
# These are safe to expose to the browser, but Vite only bundles env vars
# prefixed with VITE_ into client code — unprefixed versions here will be
# silently undefined in the built app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
