# Copy to .env.local for local dev. In Vercel, set these under
# Project Settings -> Environment Variables instead.

# ---- Firebase (client — public identifiers, not secrets) ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---- Firebase (server — secret) ----
# Full service-account JSON as a single-line string, e.g.:
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",...}
FIREBASE_SERVICE_ACCOUNT_KEY=

# ---- Paystack ----
PAYSTACK_SECRET_KEY=
# Where Paystack redirects after checkout (not the webhook URL)
PAYSTACK_CALLBACK_URL=

# ---- Telegram ----
# From @BotFather
TELEGRAM_BOT_TOKEN=

# ---- LiveKit ----
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
VITE_LIVEKIT_URL=

# ---- Gemini ----
GEMINI_API_KEY=
